# Environment variables for a site built on this CMS.
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# On Vercel, set the same variables in the project's Environment Variables
# (Production, Preview, and Development).

# ── Required ─────────────────────────────────────────────────────────

# Postgres connection string (Neon / Vercel Postgres).
DATABASE_URL=

# NextAuth v5 session-signing secret. REQUIRED in production — without it,
# NextAuth cannot sign/verify session tokens: /api/auth/* returns 500 and
# admin auth fails open (protected routes/APIs become reachable without a
# valid session). Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob read/write token (image uploads). Read automatically by
# @vercel/blob, so it won't appear in a code grep — set it anyway.
BLOB_READ_WRITE_TOKEN=

# ── Admin seed (used by `npm run db:seed`) ───────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ── Email notifications (optional) ───────────────────────────────────
# If unset, form-submission emails are skipped silently and submissions
# are still stored in the DB. See "Email Setup" in CLAUDE.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Site config overrides (optional) ─────────────────────────────────
# Prefer setting these in src/lib/site.config.ts; these env fallbacks exist
# for convenience.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=
UPLOAD_FOLDER=

# Turns the Field Map on without editing site.config.ts (handy for local work in the cms repo).
NEXT_PUBLIC_FEATURE_FIELD_MAP=
